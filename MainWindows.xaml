<Window x:Class="PluginPortfolio.MainWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="语义筛选器（AI）" Height="780" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDD"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="DeepSeek API Key" FontSize="13" FontWeight="Bold"
                           Foreground="#2196F3" Margin="0,0,0,6"/>
                <TextBox x:Name="ApiKeyBox" Height="28" FontSize="13"
                         ToolTip="sk- 开头的 Key"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="ShowKeyCheckBox" Content="显示明文"
                             Checked="ShowKeyCheckBox_Changed" Unchecked="ShowKeyCheckBox_Changed"/>
                    <Button x:Name="ForgetKeyButton" Content="忘记保存的 Key"
                            Margin="10,0,0,0" Click="ForgetKeyButton_Click"
                            Background="#E0E0E0" BorderBrush="#E0E0E0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDD"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="用自然语言说要筛选什么" FontSize="13" FontWeight="Bold"
                           Foreground="#2196F3" Margin="0,0,0,6"/>
                <TextBox x:Name="InputBox" Height="60" FontSize="13"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         KeyDown="InputBox_KeyDown"
                         ToolTip="例：找出所有外墙和门"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="SearchButton" Content="🔍 筛选" Height="34" Width="100"
                            Background="#2196F3" Foreground="White" FontWeight="Bold"
                            BorderBrush="#2196F3" Click="SearchButton_Click"/>
                    <Button x:Name="ExportButton" Content="📤 导出 CSV" Height="34" Width="110"
                            Margin="8,0,0,0" Background="#4CAF50" Foreground="White" FontWeight="Bold"
                            BorderBrush="#4CAF50" Click="ExportButton_Click" IsEnabled="False"/>
                    <Button x:Name="ClearButton" Content="🗑 清除" Height="34" Width="80"
                            Margin="8,0,0,0" Background="#E0E0E0" BorderBrush="#E0E0E0"
                            Click="ClearButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDD"
                BorderThickness="1" CornerRadius="4">
            <Grid>
                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="AI 思考中..." FontSize="16" FontWeight="Bold"
                               Foreground="#2196F3"/>
                    <TextBlock Text="请稍等，正在调用 DeepSeek API"
                               FontSize="12" Foreground="#888" Margin="0,6,0,0"/>
                </StackPanel>

                <TextBlock x:Name="EmptyHint" Text="输入指令后点击筛选"
                           FontSize="14" Foreground="#888"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          Visibility="Collapsed"
                          AlternatingRowBackground="#FAFAFA" FontSize="13"
                          ColumnHeaderHeight="30" RowHeight="26"
                          MouseDoubleClick="ResultGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="50"/>
                        <DataGridTextColumn Header="ID" Binding="{Binding ElementId}" Width="70"/>
                        <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="90"/>
                        <DataGridTextColumn Header="族" Binding="{Binding FamilyName}" Width="140"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" Width="150"/>
                        <DataGridTextColumn Header="标高" Binding="{Binding LevelName}" Width="100"/>
                        <DataGridTextColumn Header="面积(㎡)" Binding="{Binding AreaM2}" Width="90"/>
                        <DataGridTextColumn Header="体积(m³)" Binding="{Binding VolumeM3}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="StatusBar" Text="就绪" FontSize="12" Foreground="#888"/>
        </StackPanel>
    </Grid>
</Window>
