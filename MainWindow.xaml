<Window x:Class="PluginPortfolio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="多维度工程量分析" Height="740" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                BorderBrush="#DDD" BorderThickness="1" Background="White"
                CornerRadius="4" Padding="10" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="CategoriesPanel"/>

                    <TextBlock Text="2. 限定标高范围" FontSize="14" FontWeight="Bold"
                               Foreground="#2196F3" Margin="0,14,0,6"/>
                    <CheckBox x:Name="LevelAll" Content="全部标高" IsChecked="True"
                              Margin="0,2,0,4" FontSize="12"
                              Checked="LevelAllChanged" Unchecked="LevelAllChanged"/>
                    <ItemsControl x:Name="LevelList" MaxHeight="220"/>

                    <TextBlock Text="3. 族类型关键字（可空）" FontSize="14"
                               FontWeight="Bold" Foreground="#2196F3" Margin="0,14,0,6"/>
                    <TextBox x:Name="TypeKeywordBox" Height="26"
                             ToolTip="例：外墙，只保留类型名含该关键字的实例"/>
                    <TextBlock Text="留空=不过滤" FontSize="11" Foreground="#888" Margin="0,2,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AnalyzeButton" Content="▶ 开始分析" Height="34" Width="110"
                    Background="#2196F3" Foreground="White" FontWeight="Bold"
                    BorderBrush="#2196F3" Click="AnalyzeButton_Click"/>
            <Button x:Name="ExportButton" Content="📤 导出 CSV" Height="34" Width="110"
                    Margin="8,0,0,0" Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    BorderBrush="#4CAF50" Click="ExportButton_Click" IsEnabled="False"/>
            <Button x:Name="ClearButton" Content="🗑 清除结果" Height="34" Width="110"
                    Margin="8,0,0,0" Background="#E0E0E0" BorderBrush="#E0E0E0"
                    Click="ClearButton_Click"/>
        </StackPanel>

        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#DDD"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
                    <StackPanel>
                        <TextBlock x:Name="CatSummary"
                                   Text="（点击&quot;开始分析&quot;查看汇总）"
                                   FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="—— 按族类型分组计数 ——"
                                   FontSize="13" FontWeight="Bold" Foreground="#555"
                                   Margin="0,10,0,4"/>
                        <ItemsControl x:Name="TypeSummary">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#333"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="#DDD"
                    BorderThickness="1" CornerRadius="4">
                <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          AlternatingRowBackground="#FAFAFA" FontSize="13"
                          ColumnHeaderHeight="30" RowHeight="26"
                          MouseDoubleClick="ResultGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="50"/>
                        <DataGridTextColumn Header="ID" Binding="{Binding ElementId}" Width="70"/>
                        <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="90"/>
                        <DataGridTextColumn Header="族" Binding="{Binding FamilyName}" Width="140"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" Width="150"/>
                        <DataGridTextColumn Header="标高" Binding="{Binding LevelName}" Width="100"/>
                        <DataGridTextColumn Header="面积(㎡)" Binding="{Binding AreaM2}" Width="90"/>
                        <DataGridTextColumn Header="体积(m³)" Binding="{Binding VolumeM3}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="StatusBar" Text="就绪" FontSize="12" Foreground="#888"/>
        </StackPanel>
    </Grid>
</Window>
